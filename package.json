{
  "name": "pi-mention",
  "version": "0.1.0",
  "description": "Mention-aware prompt editor for pi: $ skills, % tools, & agent roles, with @ path and URL colouring",
  "type": "module",
  "license": "CC0-1.0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "mention",
    "skills",
    "autocomplete",
    "editor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jennymaeleidig/pi-mention.git"
  },
  "homepage": "https://github.com/jennymaeleidig/pi-mention#readme",
  "bugs": {
    "url": "https://github.com/jennymaeleidig/pi-mention/issues"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "GLOSSARY.md",
    "docs"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || true"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,js,json,jsonc,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.5.2",
    "linkify-it": "^6.1.0",
    "tlds": "^1.261.0"
  }
}
